APP_NAME="NP-VAMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kathmandu
APP_URL=https://yourdomain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
SUPPORTED_LOCALES=en,ne

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- MySQL/MariaDB via cPanel's "MySQL Databases" tool ---
# cPanel-created DB/user names are usually prefixed with your cPanel
# username, e.g. "cpaneluser_npvams" / "cpaneluser_npvamsuser".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_npvams
DB_USERNAME=cpaneluser_npvamsuser
DB_PASSWORD=change_me

# --- No Redis on shared hosting: database-backed cache/session/queue ---
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# --- Private document storage: local disk outside the public webroot ---
FILESYSTEM_DISK=local
DOCUMENTS_DISK=private_documents
# Optional upgrade to S3-compatible storage (DigitalOcean Spaces, Backblaze
# B2, Cloudflare R2) -- only used if DOCUMENTS_DISK=s3 above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=480

# --- cPanel email account, or your host's SMTP relay ---
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Nepal-specific: never hard-coded elsewhere, configured here / in DB master data ---
NEPALI_FISCAL_YEAR_START_MONTH=4

MFA_ENABLED=true
PASSWORD_MIN_LENGTH=10
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15
